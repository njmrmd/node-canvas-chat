# Copy to .env.local for development. NEVER commit a filled-in copy —
# .gitignore blocks .env and .env.* with .env.example as the only exception.
#
# On Vercel these live in Project → Settings → Environment Variables.
# Give Preview and Production separate values for KEY_VAULT_ENCRYPTION_KEY, so
# a preview deployment structurally cannot decrypt a production key.

# --- Database (Postgres) ------------------------------------------------------
# Pooled connection string, used by the app at runtime. Point this at a pooled
# (pgbouncer) endpoint — the app opens one connection per function instance.
# Hosted: end the URL with ?sslmode=verify-full. Local: ?sslmode=disable.
DATABASE_URL=

# Direct (non-pooled) connection string, used by `pnpm db:migrate` only.
# Pooled endpoints do not run every DDL statement reliably.
DATABASE_URL_UNPOOLED=

# --- BYO model key vault ------------------------------------------------------
# 32-byte base64 key that AES-256-GCM encrypts user-supplied provider API keys
# at rest. Server-only; it is never sent to a browser and never stored in the
# database — that separation is what makes a database dump inert.
#
# Rotating this invalidates every stored user key; each user has to reconnect.
#
# Generate with: openssl rand -base64 32
KEY_VAULT_ENCRYPTION_KEY=

# --- Optional -----------------------------------------------------------------
# Canonical origin, e.g. https://node-canvas-chat.vercel.app. Only needed if the
# app is served from a domain the request's Host header does not report. The
# CSRF check derives its allowlist from the request itself, so preview
# deployments work without setting this.
APP_ORIGIN=
