# Copy to .env.local for development. NEVER commit a filled-in copy —
# .gitignore blocks .env and .env.* with .env.example as the only exception.
#
# Nothing here is live yet: the scaffold (TES-3) runs with zero environment
# variables. These are the slots the auth/key-vault work will fill.

# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection string, used by the app at runtime.
DATABASE_URL=

# Direct (non-pooled) connection string, used by migrations only.
DATABASE_URL_UNPOOLED=

# --- Auth (Auth.js v5) --------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# OAuth providers. Callback URL: {origin}/api/auth/callback/{provider}
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- BYO model key vault ------------------------------------------------------
# 32-byte base64 key used to AES-256-GCM encrypt user-supplied provider API
# keys at rest. Server-only. Rotating this invalidates every stored user key.
# Generate with: openssl rand -base64 32
KEY_VAULT_ENCRYPTION_KEY=
